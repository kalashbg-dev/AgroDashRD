# Copy to .env and adjust. Never commit the real .env.
# development | production. Production refuses to start on SQLite.
AGRODASH_ENV=development
# PostgreSQL example: postgresql+psycopg://user:password@host:5432/agrodash
AGRODASH_DATABASE_URL=sqlite:///agrodash.db

# docker-compose PostgreSQL (required by `docker compose up`).
POSTGRES_PASSWORD=
# With docker compose: AGRODASH_DATABASE_URL=postgresql+psycopg://agrodash:<password>@localhost:5432/agrodash
